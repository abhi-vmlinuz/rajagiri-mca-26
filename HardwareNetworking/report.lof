\contentsline {figure}{\numberline {1}{\ignorespaces Complete RCSS campus network topology in Cisco Packet Tracer. The router \texttt {RCSS-R1} connects to the core switch \texttt {RCSS-SW-CORE}, which in turn connects to the three building switches and, through them, to the eleven end devices.}}{8}{figure.caption.2}%
\contentsline {figure}{\numberline {2}{\ignorespaces Enlarged left half of the topology: the Assumption block with \texttt {ASSUMPTION-ADMIN01}, \texttt {ASSUMPTION-ADMIN02}, \texttt {ASSUMPTION-FACULTY01} and the server \texttt {RCSS-SRV01}, together with the core switch and the router.}}{10}{figure.caption.4}%
\contentsline {figure}{\numberline {3}{\ignorespaces Enlarged right half of the topology: the Carmel block (printer, faculty PC, reception and office devices), the Old Block laboratory (two lab PCs and the old reception device) and their uplinks to the core switch.}}{11}{figure.caption.5}%
\contentsline {figure}{\numberline {4}{\ignorespaces \texttt {show ip interface brief} on \texttt {RCSS-R1}. The four subinterfaces \texttt {Gi0/0.10} to \texttt {Gi0/0.40} are up/up with the gateway addresses of VLANs 10, 20, 30 and 40; the physical \texttt {Gi0/0} is up/up and carries the trunk.}}{12}{figure.caption.8}%
\contentsline {figure}{\numberline {5}{\ignorespaces \texttt {show vlan brief} on \texttt {RCSS-SW-CORE}. VLANs 10, 20, 30 and 40 are active; no access ports are listed because every core port is a trunk.}}{13}{figure.caption.9}%
\contentsline {figure}{\numberline {6}{\ignorespaces \texttt {show interfaces trunk} on \texttt {RCSS-SW-CORE}. Ports \texttt {Fa0/1}, \texttt {Fa0/2}, \texttt {Gi0/1} and \texttt {Gi0/2} are all 802.1Q trunks carrying VLANs 1, 10, 20, 30 and 40.}}{14}{figure.caption.10}%
\contentsline {figure}{\numberline {7}{\ignorespaces \texttt {show vlan brief} on \texttt {RCSS-SW-ASSUMPTION}. VLAN 10 carries the access ports Fa0/1, Fa0/2 and Fa0/4; VLAN 40 carries Fa0/3, the server port.}}{14}{figure.caption.11}%
\contentsline {figure}{\numberline {8}{\ignorespaces \texttt {show vlan brief} on \texttt {RCSS-SW-CARMEL}. VLAN 10 carries Fa0/1, Fa0/3 and Fa0/4; VLAN 20 carries Fa0/2. The port \texttt {Gi0/2} is listed under the default VLAN 1 and is unused (see Section~\ref {sec:discrepancies}).}}{15}{figure.caption.12}%
\contentsline {figure}{\numberline {9}{\ignorespaces \texttt {show vlan brief} on \texttt {RCSS-SW-OLDBLOCK}. VLAN 30 (\texttt {OLDBLOCK-LAB}) carries the three access ports Fa0/1, Fa0/2 and Fa0/3.}}{15}{figure.caption.13}%
\contentsline {figure}{\numberline {10}{\ignorespaces \texttt {show interfaces trunk} on \texttt {RCSS-SW-ASSUMPTION}. The uplink \texttt {Gi0/1} is trunking and carries VLANs 1, 10 and 40.}}{16}{figure.caption.14}%
\contentsline {figure}{\numberline {11}{\ignorespaces \texttt {show interfaces trunk} on \texttt {RCSS-SW-CARMEL}. The uplink \texttt {Gi0/1} is trunking and carries VLANs 1, 10 and 20. This confirms that \texttt {Gi0/1}, and not \texttt {Gi0/2}, is the active Carmel uplink.}}{16}{figure.caption.15}%
\contentsline {figure}{\numberline {12}{\ignorespaces \texttt {show interfaces trunk} on \texttt {RCSS-SW-OLDBLOCK}. The uplink \texttt {Gi0/1} is trunking and carries VLANs 1 and 30.}}{17}{figure.caption.16}%
\contentsline {figure}{\numberline {13}{\ignorespaces \texttt {show ip dhcp pool} on \texttt {RCSS-R1}. Four pools are defined; six clients are leased in the Assumption pool, one in Carmel, three in Old Block and none in the server pool, which is consistent with the static server address.}}{19}{figure.caption.20}%
\contentsline {figure}{\numberline {14}{\ignorespaces \texttt {show ip dhcp binding} on \texttt {RCSS-R1}. Six leases in the VLAN 10 subnet, one in VLAN 20 and two in VLAN 30; every lease starts at .21 or above, and no lease exists in the server subnet.}}{20}{figure.caption.21}%
\contentsline {figure}{\numberline {15}{\ignorespaces \texttt {show ip route} on \texttt {RCSS-R1}. The four campus subnets are connected through the subinterfaces Gi0/0.10, Gi0/0.20, Gi0/0.30 and Gi0/0.40; there is no default route.}}{23}{figure.caption.22}%
\contentsline {figure}{\numberline {16}{\ignorespaces DHCP section of \texttt {show running-config} on \texttt {RCSS-R1}. The excluded ranges .\textit {x}.1 to .\textit {x}.20 and the four pools with their networks and default routers are present in the running configuration.}}{24}{figure.caption.23}%
\contentsline {figure}{\numberline {17}{\ignorespaces ICMP ping to 192.168.20.21. Four requests were sent and three replies were received (25\% loss); the first request timed out during address resolution.}}{25}{figure.caption.24}%
