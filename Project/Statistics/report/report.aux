\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Distribution of first-innings target runs (n = 686). The histogram is scaled to a density and overlaid with a kernel density estimate; the dashed line marks the mean of 160.54.}}{2}{}\protected@file@percent }
